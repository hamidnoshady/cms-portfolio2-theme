# Meridian — environment reference.
#
# Attached to eshobe-cms: the platform injects these at deploy time. They are never tenant
# questions, must not be committed or baked into an image, and are server-side only.
ESHOBE_CMS_URL=
ESHOBE_API_KEY=
ESHOBE_SITE_ID=
ESHOBE_SITE_DOMAIN=
ESHOBE_PUBLIC_ORIGIN=
ESHOBE_REVALIDATE_SECRET=

# Standalone (no ESHOBE_CMS_URL / ESHOBE_API_KEY): local Postgres seeded with dummy content.
# DATABASE_URL=postgres://user:pass@localhost:5432/meridian
