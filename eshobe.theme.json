    { "key": "contact", "type": "page", "required": false, "labelEn": "Contact page", "labelFa": "صفحهٔ تماس", "help": "Its contact block supplies email, phone and address." },
    { "key": "contactForm", "type": "form", "required": false, "labelEn": "Contact form", "labelFa": "فرم تماس", "help": "Fields: reason (select), name, email, message." }
  ]
