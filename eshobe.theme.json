  "contentSlots": [
    { "key": "home", "type": "page", "required": false, "labelEn": "Home page", "labelFa": "صفحهٔ اصلی", "help": "Hero richText paragraphs = the big statement lines; first content block = intro." },
    { "key": "about", "type": "page", "required": false, "labelEn": "About page", "labelFa": "صفحهٔ درباره ما", "help": "See docs/CMS-SETUP.md for the block order." },
